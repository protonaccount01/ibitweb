# Cloudflare Pages reads this file automatically and attaches these headers
# to every response. See: https://developers.cloudflare.com/pages/configuration/headers/
#
# NOTE on CSP: this codebase uses inline <script> blocks and onclick="..."
# attributes throughout (not just in the files touched by this fix), so
# 'unsafe-inline' is kept for script-src/style-src to avoid breaking the
# site. The real hardening here is still meaningful (no execution from
# other origins, no framing, no MIME-sniffing) — removing inline
# handlers in favor of addEventListener + a nonce-based CSP is the
# natural next step, tracked in SECURITY-CHANGES.md.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.quilljs.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.quilljs.com; img-src 'self' data: https:; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://docs.google.com https://www.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
